# --------------------------------------------------------------------------------
# Sample environment file for docker-compose.yml
#
# Copy to `.env` and edit, then run:  docker compose up -d
# --------------------------------------------------------------------------------

# Server service name
NAME=perforce-server

# Server (chassis) name
P4NAME=master

# TCP port the server listens on
P4TCP=1666

# Port used by p4 configure (defaults to P4TCP)
P4PORT=1666

# Initial super user
P4USER=admin

# Initial super user password
P4PASSWD=pass12349ers

# Case sensitivity flag
P4CASE=-C0

# Server charset
P4CHARSET=utf8

# Journal prefix
JNL_PREFIX=perforce-server

# Depots storage directory on host (local folder or NAS path)
P4DEPOTS_PATH=./depots

# Default CLI editor for forms (e.g. nano, vi)
P4EDITOR=nano
